<?xml version="1.0" encoding="utf-8"?>
<!-- Package/namespace comes from the build (AGP: namespace; lite build: injected). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Local network only (TLS between the two phones). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Multicast lock for NSD/mDNS discovery over the local link (not in Play Protect's sensitive set). -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Host: capture service with a visible notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Controller: scanning the pairing QR code. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nitaaq">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".host.HostActivity" android:launchMode="singleTop" android:exported="false" />
        <activity android:name=".ctrl.ControllerActivity" android:exported="false" />
        <activity android:name=".ctrl.ScanActivity" android:screenOrientation="portrait" android:exported="false" />
        <activity
            android:name=".ctrl.RemoteActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Nitaaq.Remote"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|density|uiMode" />
        <activity android:name=".TrustedDevicesActivity" android:exported="false" />
        <activity android:name=".SettingsActivity" android:exported="false" />

        <service
            android:name=".host.HostService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

    </application>
</manifest>
